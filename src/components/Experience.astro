---
import ExperienceItem from "./ExperienceItem.astro"

const EXPERIENCE = [
    {
        date: "June 2025 - Present",
        title: "Delivery Analyst, AI & Data - Deloitte",
        description: "Building AI and data solutions for enterprise and public-sector teams.",
        bullets: [
            "Contributed to an end-to-end Python evaluation pipeline for LLM-as-a-Judge systems, using the OpenAI API to assess judge reliability in a banking use case.",
            "Connected Databricks Genie to a remote Azure DevOps Model Context Protocol (MCP) server, enabling access to Azure DevOps tools.",
            "Designed and implemented a conversational data intelligence solution so non-technical business users can explore enterprise data in natural language.",
            "Developed ETLs and supported data management and ingestion for a Spanish public-sector project.",
            "Contribute to internal AI Agent and agent-skill proofs of concept, and create presentations to explain AI concepts to colleagues.",
            "Worked as Scrum Master and Business Analyst on an international delivery, coordinating a team in India and liaising with Business Analysts and OCM teams."
        ]
    }
]
---

<ol class="relative border-s border-white/15 ml-3">                  
    {
        EXPERIENCE.map((experience) => (
            <li class="mb-10 ms-4">
                <ExperienceItem {...experience} />
                {experience.bullets && (
                    <ul class="mt-2 ml-6 list-disc marker:text-teal-200 text-pretty text-base text-slate-300 space-y-2 leading-relaxed">
                        {experience.bullets.map(b => <li>{b}</li>)}
                    </ul>
                )}
            </li>
        ))
    }
</ol>

