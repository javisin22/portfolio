---
const PROJECTS = [
	{
		title: "Compiler Speedup Prediction",
		context: "Senior thesis · University of Rhode Island",
		description: "Explored how source code and compiler flags relate to optimization speedups. The work used Hugging Face CodeRankEmbed, LoRA / PEFT fine-tuning and a PyTorch regression model.",
		image: "/projects/compiler-speedup.svg",
		alt: "Diagram of source code and compiler flags feeding a machine learning model to predict speedup",
		tags: ["CodeRankEmbed", "LoRA / PEFT", "PyTorch", "Compiler optimization"]
	},
	{
		title: "FitConnect",
		context: "Bachelor's final project · University of Zaragoza",
		description: "In development: a full-stack social application for fitness enthusiasts, built with Next.js, TypeScript, React and Supabase.",
		image: "/projects/tfg.webp",
		alt: "FitConnect web application interface showing a fitness community feed",
		tags: ["Next.js", "TypeScript", "React", "Supabase"]
	}
]
---

{
	PROJECTS.map((project, index) => (
		<article class={`grid gap-5 border-t border-white/10 py-7 md:grid-cols-[minmax(0,0.9fr)_minmax(0,1fr)] md:items-center ${index === 0 ? "md:pt-2" : ""}`}>
			<div class={index === 0 ? "md:order-2" : ""}>
				<img class="w-full aspect-[16/10] object-cover rounded-md border border-white/10" src={project.image} alt={project.alt} loading="lazy" />
			</div>
			<div class={index === 0 ? "md:order-1" : ""}>
				<p class="text-sm text-teal-200 mb-2">{project.context}</p>
				<h3 class="text-2xl font-semibold text-white mb-3">{project.title}</h3>
				<p class="text-base text-slate-300 leading-relaxed text-pretty">{project.description}</p>
				<ul class="flex flex-wrap gap-2 mt-4" aria-label={`${project.title} technologies`}>
					{project.tags.map(tag => <li class="rounded border border-white/10 px-2 py-1 text-xs text-slate-300">{tag}</li>)}
				</ul>
			</div>
		</article>
	))
}
